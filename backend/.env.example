NODE_ENV=development
HOST=127.0.0.1
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shehersaaz_forms

ALLOWED_ORIGINS=
ADMIN_SESSION_TTL_MS=28800000
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=5

# Development-only fallback admin login.
# Leave ALLOW_ENV_ADMIN_FALLBACK=false in production and create DB-backed admins instead.
ALLOW_ENV_ADMIN_FALLBACK=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional one-time admin seed helper.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
